# Copy to .env for local Docker use. Never commit the populated file.
# Explanation: Environment setting APP_ENV: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
APP_ENV=production
# Explanation: Environment setting HOST: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
HOST=0.0.0.0
# Explanation: Environment setting PORT: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
PORT=8000
# Optional: set BOTH values to use environment-managed credentials instead of first-run setup.
# If both are blank, open the dashboard and create the first administrator in the setup page.
# DASHBOARD_USERNAME=canary-admin
# DASHBOARD_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# Explanation: Environment setting CANARYTRAP_DB: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_DB=/app/data/canarytrap.sqlite3
# Explanation: Environment setting CANARYTRAP_HTTP_UPSTREAMS: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_HTTP_UPSTREAMS={}
# Explanation: Environment setting CANARYTRAP_UPSTREAM_TIMEOUT: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_UPSTREAM_TIMEOUT=60
# Explanation: Environment setting CANARYTRAP_MAX_REQUEST_BYTES: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_MAX_REQUEST_BYTES=2097152

# Security Center. Leave RBAC key map empty only for local development.
# Explanation: Environment setting CANARYTRAP_RBAC_KEYS: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_RBAC_KEYS=
# Explanation: Environment setting CANARYTRAP_DEFAULT_TENANT: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_DEFAULT_TENANT=default
# allow (default) or deny; explicit matching policy rules override this fallback.
# Explanation: Environment setting CANARYTRAP_DEFAULT_POLICY_ACTION: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_DEFAULT_POLICY_ACTION=allow
# Restrict upstream hosts with a comma-separated exact-host allowlist where practical.
# Explanation: Environment setting CANARYTRAP_ALLOWED_UPSTREAM_HOSTS: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_ALLOWED_UPSTREAM_HOSTS=
# Set true only when approved private-network MCP upstreams are required.
# Explanation: Environment setting CANARYTRAP_ALLOW_PRIVATE_UPSTREAMS: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_ALLOW_PRIVATE_UPSTREAMS=false
# Optional global HTTPS webhook fallback. Prefer configuring a tenant-scoped webhook in Security Center.
# Explanation: Environment setting CANARYTRAP_WEBHOOK_URL: a placeholder/default that can be overridden outside source control; never put real secrets in this example file.
CANARYTRAP_WEBHOOK_URL=
